# Sao chép thành .env rồi điền giá trị. File .env không được đưa lên git.
# Lấy ở Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3210/auth/google/callback (và <BASE_URL>/auth/google/callback khi chạy thật)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mật khẩu vào trang quản trị /admin. Để trống thì trang quản trị bị khoá.
ADMIN_PASSWORD=
