{
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,lib,templates}/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "to-hong.vercel.app" }], "destination": "https://cuoinha.com/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "to-hong.vercel.app" }], "destination": "https://cuoinha.com/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dang-nhap", "destination": "/auth.html" },
    { "source": "/thiep-cua-toi", "destination": "/dashboard.html" },
    { "source": "/video-cua-toi", "destination": "/dashboard.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/mau-thiep", "destination": "/templates.html" },
    { "source": "/video-cuoi", "destination": "/video-landing.html" },
    { "source": "/man-hinh-led-dam-cuoi", "destination": "/led-landing.html" },
    { "source": "/so-tay", "destination": "/planner.html" },
    { "source": "/so-tay-cuoi", "destination": "/planner-landing.html" },
    { "source": "/sua/:id", "destination": "/editor.html" },
    { "source": "/sua-led/:id", "destination": "/led-editor.html" },
    { "source": "/sua-video/:id", "destination": "/video-editor.html" },
    { "source": "/tham-gia/:id", "destination": "/join.html" },
    { "source": "/:path*", "destination": "/api/index.js?__p=/:path*" }
  ]
}
