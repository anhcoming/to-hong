{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{lib/**,templates/**,public/*.html}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/demo/(.*)\\.(jpg|jpeg|png|webp|svg|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/demo/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/music/(.*)\\.mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/don-hang", "destination": "/gio-hang", "permanent": false },
    { "source": "/video-cua-toi", "destination": "/thiep-cua-toi", "permanent": false },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "to-hong.vercel.app"
        }
      ],
      "destination": "https://cuoinha.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "to-hong.vercel.app"
        }
      ],
      "destination": "https://cuoinha.com/:path*",
      "permanent": true
    },
    {
      "source": "/video-cuoi",
      "destination": "/video-dam-ngo",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dang-nhap", "destination": "/auth.html" },
    { "source": "/thiep-cua-toi", "destination": "/dashboard.html" },
    
    
    { "source": "/gio-hang", "destination": "/cart.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/mau-thiep", "destination": "/templates.html" },
    { "source": "/video-dam-ngo", "destination": "/video-landing.html" },
    { "source": "/slide-cuoi", "destination": "/slide-landing.html" },
    { "source": "/man-hinh-led-dam-cuoi", "destination": "/led-landing.html" },
    { "source": "/so-tay", "destination": "/planner.html" },
    { "source": "/so-tay-cuoi", "destination": "/planner-landing.html" },
    { "source": "/goi-y", "destination": "/suggest.html" },
    { "source": "/dieu-khoan", "destination": "/dieu-khoan.html" },
    { "source": "/chinh-sach-bao-mat", "destination": "/chinh-sach-bao-mat.html" },
    { "source": "/hoan-tien", "destination": "/hoan-tien.html" },
    { "source": "/sua/:id", "destination": "/editor.html" },
    { "source": "/sua-led/:id", "destination": "/led-editor.html" },
    { "source": "/chon/:id", "destination": "/chon.html" },
    { "source": "/sua-video/:id", "destination": "/video-editor.html" },
    { "source": "/tham-gia/:id", "destination": "/join.html" },
    { "source": "/:path*", "destination": "/api/index.js?__p=/:path*" }
  ]
}
